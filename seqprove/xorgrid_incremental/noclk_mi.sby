# smtbmc-yices: smtbmc yices
# smtbmc-bootlector: smtbmc bootlector
smtbmc-bitwuzla: smtbmc bitwuzla
smtbmc-z3: smtbmc z3
# smtbmc-mathsat: smtbmc mathsat
# smtbmc-cvc4: smtbmc cvc4
# smtbmc-cvc5: smtbmc cvc5

abc-pdr: abc pdr
# abc-sim3: abc sim3
# abc-bmc3: abc bmc3

aiger-suprove: aiger suprove
# aiger-avy: aiger avy
aiger-rIC3: aiger rIC3
# aiger-bmc: aiger aigbmc


[script]
# Gold
read_rtlil gold.il

# Gate
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil gate.il

# Miter
plugin -i slang
read_slang --top miter miter.v -G I=16 -G O=16 -G C=16
hierarchy -top miter
flatten

async2sync

setundef -zero
setundef -undriven -init -zero

[files]
sky130
miter.v
gold.il
gate.il
