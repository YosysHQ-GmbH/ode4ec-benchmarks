[tasks]
abc-pdr
abc-sim3
abc-bmc3

aiger-suprove
aiger-avy
aiger-rIC3
aiger-bmc

smtbmc-yices
smtbmc-bootlector
smtbmc-bitwuzla
smtbmc-z3
smtbmc-mathsat
smtbmc-cvc4
smtbmc-cvc5

btor-btormc
btor-pono
btor-rIC3

itp

[options]
itp: mode prove

smtbmc-yices: mode bmc
smtbmc-yices: depth 20
smtbmc-yices: timeout {timeout}

smtbmc-bootlector: mode bmc
smtbmc-bootlector: depth 20
smtbmc-bootlector: timeout {timeout}

smtbmc-bitwuzla: mode bmc
smtbmc-bitwuzla: depth 20
smtbmc-bitwuzla: timeout {timeout}

smtbmc-z3: mode bmc
smtbmc-z3: depth 20
smtbmc-z3: timeout {timeout}

smtbmc-mathsat: mode bmc
smtbmc-mathsat: depth 20
smtbmc-mathsat: timeout {timeout}

smtbmc-cvc4: mode bmc
smtbmc-cvc4: depth 20
smtbmc-cvc4: timeout {timeout}

smtbmc-cvc5: mode bmc
smtbmc-cvc5: depth 20
smtbmc-cvc5: timeout {timeout}

btor-btormc: mode bmc
btor-btormc: depth 20
btor-btormc: timeout {timeout}
btor-pono: mode bmc
btor-pono: depth 20
btor-pono: timeout {timeout}
btor-rIC3: mode bmc
btor-rIC3: depth 20
btor-rIC3: timeout {timeout}

abc-pdr: mode prove
abc-pdr: timeout {timeout}
abc-sim3: mode bmc
abc-sim3: depth 20
abc-sim3: timeout {timeout}
abc-bmc3: mode bmc
abc-bmc3: depth 20
abc-bmc3: timeout {timeout}

aiger-suprove: mode prove
aiger-suprove: timeout {timeout}
aiger-avy: mode prove
aiger-avy: timeout {timeout}
aiger-rIC3: mode prove
aiger-rIC3: timeout {timeout}
aiger-bmc: mode bmc 
aiger-bmc: depth 20 
aiger-bmc: timeout {timeout}

[engines]
itp: itp 20 0

btor-btormc: btor btormc
btor-pono: btor pono 
btor-rIC3: btor rIC3 

smtbmc-yices: smtbmc yices
smtbmc-bootlector: smtbmc bootlector
smtbmc-bitwuzla: smtbmc bitwuzla
smtbmc-z3: smtbmc z3
smtbmc-mathsat: smtbmc mathsat
smtbmc-cvc4: smtbmc cvc4
smtbmc-cvc5: smtbmc cvc5

abc-pdr: abc pdr
