[script]
# Gold
read_rtlil gold.il

# Gate
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil gate.il

# Miter
plugin -i slang
read_slang --top miter miter.v -G I={I} -G O={O} -G C={C}
hierarchy -top miter
flatten

async2sync
clk2fflogic

setundef -zero
setundef -undriven -init -zero

[files]
../../sky130
miter.v
gold.il
gate.il
