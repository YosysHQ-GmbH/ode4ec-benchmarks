[tasks]
task_abc
task_aiger
task_bitwuzla
task_btor

[options]
task_bitwuzla: mode bmc
task_bitwuzla: depth 70
task_bitwuzla: timeout 600
task_btor: mode bmc
task_btor: depth 70
task_btor: timeout 600

task_abc: mode prove
task_abc: timeout 600
task_aiger: mode prove
task_aiger: timeout 600

[engines]
task_btor: btor btormc
task_bitwuzla: smtbmc bitwuzla

task_abc: abc pdr
task_aiger: aiger suprove

[script]
# Gold
read_rtlil @GOLD@

# Gate (mutated: see mutate.tcl)
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil @MUTATED@
chformal -assert -remove

# Miter
plugin -i slang
read_slang --top miter miter.v
hierarchy -top miter
flatten

prep -top miter

setundef -zero
setundef -undriven -init -zero

async2sync
clk2fflogic

[files]
../sky130
../miter.v
@GOLD@
@MUTATED@
