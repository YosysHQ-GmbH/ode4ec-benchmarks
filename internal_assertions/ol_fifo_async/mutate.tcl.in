yosys -import

read_liberty -ignore_miss_func ../sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_slang --top olo_base_fifo_async @NETLIST@
yosys rename olo_base_fifo_async gate_top
yosys cd gate_top

mutate -list @NMUTATIONS@ -seed @SEED@ -o mutations.txt

set fp [open "mutations.txt" r]
set mutation_lines [split [string trim [read $fp]] "\n"]
close $fp
foreach mutation_line $mutation_lines {
    set mutation_words [regexp -all -inline {\S+} $mutation_line]
    {*}$mutation_words
}

yosys cd ..

select gate_top
write_rtlil -selected @MUTATED@
select -clear
