[options]
mode bmc
depth 40

[engines]
btor btormc

[script]
# Gold
read_rtlil @GOLD@
chformal -assert -remove

# Gate (mutated: see ../mutate.tcl.in)
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil @MUTATED@
chformal -assert -remove

# Miter
plugin -i slang
read_slang --top miter @MITER@

hierarchy -top miter
flatten

prep -top miter
opt
fminit -seq In_Rst 1,1,0 -posedge In_Clk
fminit -seq Out_Rst 1,1,0 -posedge Out_Clk

async2sync
clk2fflogic

setundef -zero
setundef -undriven -init -zero

[files]
../sky130
@MITER@
@GOLD@
@MUTATED@
