[tasks]
task_btor
task_abc
task_aiger
task_bitwuzla

[options]
task_btor: mode bmc
task_btor: depth 100
task_btor: timeout 1800

task_abc: mode prove
task_abc: timeout 1800
task_aiger: mode prove
task_aiger: timeout 1800

task_bitwuzla: mode bmc
task_bitwuzla: depth 100
task_bitwuzla: timeout 1800

[engines]
task_btor: btor btormc
task_bitwuzla: smtbmc bitwuzla

task_abc: abc pdr
task_aiger: aiger suprove

[script]
# Gold
read_rtlil gold_out.il

# Gate
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil gate_out.il
chformal -assert -remove

# Miter
plugin -i ghdl
ghdl --std=08 -fpsl src/pp_types.vhd src/pp_constants.vhd src/pp_utilities.vhd miter.vhd -e miter
hierarchy -top miter
flatten

prep -top miter

setundef -zero
setundef -undriven -init -zero

async2sync
clk2fflogic

[files]
../src
../sky130
../miter.vhd
gold_out.il
gate_out.il
