[tasks]
task_plain_pdr
task_plain_suprove
task_plain_rIC3
task_ia internal_include

[options]
task_plain_pdr: mode prove
task_plain_pdr: timeout 1800
task_plain_suprove: mode prove
task_plain_suprove: timeout 1800
task_plain_rIC3: mode prove
task_plain_rIC3: timeout 1800
task_ia: mode prove
task_ia: timeout 1800

[engines]
task_plain_pdr: abc pdr
task_plain_suprove: aiger suprove
task_plain_rIC3: aiger rIC3
task_ia: abc pdr

[script]
# Variant of custom_miter.sby / custom_miter_with_extra_asserts.sby (yosys gate) for the plain sby /
# seq_prove / eqy comparison (seqprove/seqprove/run_bench.py, case options dir= sby= task=).
# task_plain_*: the output asserts only (plain miter, three complete engines);
# task_ia: plus the internal asserts; seqprove/seqprove/build_model.py builds seq_prove's model from it
# (it drops clk2fflogic). Tag internal_include: tasks that read the internal-assert include.

# Gold
read_rtlil gold_out.il

# Gate
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil gate_out.il
chformal -assert -remove

# Miter (the miter includes the decls/ports files in every task; the expose script makes their ports)
script expose_yosys.ys
plugin -i slang
internal_include: read_slang --top miter -D INTERNAL_ASSERTS miter.v
~internal_include: read_slang --top miter miter.v

hierarchy -top miter
flatten
opt

# Reset sequence (assumption, approved 2026-10-05 as for cva6 and neorv32): reset_n (active low,
# asynchronous) is 0 until the second rising edge of clk, then free (it may be asserted again later).
# Weaker than the benchmark's own `0,0,1` (reset never again). Two edges, not one: with clk2fflogic the
# first edge can be at step 0, where a register loads its init value, not the reset.
fminit -seq reset_n 0,0,'z -posedge clk

async2sync
clk2fflogic

setundef -zero
setundef -undriven -init -zero

# Plain tasks only (AIGER export): the gold's $shiftx `digest_reg[(7 - (address - ADDR_DIGEST0)) * 32 +: 32]`
# (sha256.v:235) yields x for an out-of-range index, but only after sby's own techmap, i.e. after the
# setundef above; write_aiger refuses x bits. Bit-blast here and read them as 0, the convention of the
# setundef above and of yosys' SMT2 backend (seq_prove's model reads out-of-range $shiftx bits as 0). This
# only asks more of the gate (it must match gold with these bits fixed), so it cannot turn a difference into
# a PASS; here the bits are never selected anyway (the read is inside `if` address in the digest range).
~internal_include: techmap; opt -fast; setundef -zero

[files]
../sky130
../miter.v
internal_helper_asserts.vh ../internal_asserts/asserts_yosys.vh
internal_helper_decls.vh ../internal_asserts/decls_yosys.vh
../internal_asserts/expose_yosys.ys
internal_helper_ports_a.vh ../internal_asserts/ports_a_yosys.vh
internal_helper_ports_b.vh ../internal_asserts/ports_b_yosys.vh
gold_out.il
gate_out.il gate_out_yosys.il
