[options]
splitnets on

[gold]
plugin -i ghdl
ghdl --std=08 -frelaxed -gChannels_g=@CHANNEL@ -gWidth_g=@WIDTH@ ../src/olo_base_pkg_array.vhd ../src/olo_base_pkg_attribute.vhd ../src/olo_base_pkg_math.vhd ../src/olo_base_pkg_logic.vhd ../src/olo_base_pkg_string.vhd ../src/olo_base_cc_reset.vhd ../src/olo_base_cc_bits.vhd ../src/olo_base_ram_sdp.vhd ../src/olo_base_tdm_mux.vhd -e olo_base_tdm_mux
hierarchy -check -top olo_base_tdm_mux
memory_map -formal
async2sync
flatten

[gate]
read_liberty -lib ../sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
plugin -i slang
read_slang --top olo_base_tdm_mux ./@NETLIST@

[script]
select -module olo_base_tdm_mux
fminit -seq Clk 0,'z
select -clear

[collect *]
bind *

[strategy sby]
use sby
engine smtbmc bitwuzla
depth 12
