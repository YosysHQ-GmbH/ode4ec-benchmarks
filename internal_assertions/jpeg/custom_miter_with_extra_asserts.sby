[tasks]
task_bmc
task_pdr
task_kind
task_itp
task_portfolio

[options]
task_bmc: mode bmc
task_bmc: depth 170
task_bmc: timeout 7200

task_pdr: mode prove
task_pdr: timeout 1800

task_kind: mode prove
task_kind: timeout 1800

task_itp: mode prove
task_itp: timeout 1800

task_portfolio: mode prove
task_portfolio: timeout 1800

[engines]
task_bmc: smtbmc bitwuzla
task_pdr: btor rIC3 -e ic3
task_kind: btor rIC3 -e kind --kind-simple-path
task_itp: aiger avy
task_portfolio: aiger suprove

[script]
# Gold
read_rtlil gold_out.il

# Gate
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil gate_out.il

# Miter
script expose_yosys.ys
plugin -i slang
read_slang --top miter -D INTERNAL_ASSERTS miter.v

hierarchy -top miter
flatten
opt
fminit -seq rst 0,0,1 -posedge clk

async2sync

setundef -zero
setundef -undriven -init -zero

[files]
../sky130
../miter.v
internal_helper_asserts.vh ../internal_asserts/asserts_yosys.vh
internal_helper_decls.vh ../internal_asserts/decls_yosys.vh
../internal_asserts/expose_yosys.ys
internal_helper_ports_a.vh ../internal_asserts/ports_a_yosys.vh
internal_helper_ports_b.vh ../internal_asserts/ports_b_yosys.vh
gold_out.il
gate_out.il
