[tasks]
task_bmc
task_prove

[options]
task_bmc: mode bmc
task_bmc: depth 10 
task_prove: mode prove

[engines]
task_bmc: smtbmc bitwuzla
task_prove: abc pdr

[script]
# Gold
plugin -i ghdl
ghdl --std=08 -frelaxed -gWidth_g=@WIDTH@ -gStages_g=@STAGE@ -gUseReady_g=@READY@ src/olo_base_pkg_array.vhd src/olo_base_pkg_attribute.vhd src/olo_base_pkg_math.vhd src/olo_base_pkg_logic.vhd src/olo_base_pkg_string.vhd src/olo_base_cc_reset.vhd src/olo_base_cc_bits.vhd src/olo_base_ram_sdp.vhd src/olo_base_pl_stage.vhd -e olo_base_pl_stage

hierarchy -check -top olo_base_pl_stage
memory_map -formal
flatten

rename olo_base_pl_stage gold_top
design -stash gold

# Gate
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
plugin -i slang
read_slang --top olo_base_pl_stage ./@NETLIST@

rename olo_base_pl_stage gate_top 
design -stash gate

# Miter
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
design -copy-from gold -as gold_top gold_top
design -copy-from gate -as gate_top gate_top

#equiv_make gold_top gate_top equiv_miter
miter -equiv -flatten -make_assert gold_top gate_top equiv_miter
hierarchy -top equiv_miter

select -module equiv_miter
fminit -seq in_Rst 1,1,0
fminit -seq in_Clk 0,'z
select -clear

clk2fflogic
setundef -undriven -init -zero

[files]
../src
../sky130
@NETLIST@
