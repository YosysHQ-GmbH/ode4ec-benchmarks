module miter (
    input Clk,
    input [$clog2(@DEPTH@)-1:0] Addr,
    input WrEna,
    input [@WIDTH@-1:0] WrData
);

    wire [@WIDTH@-1:0] gold_RdData, gate_RdData;

`ifdef INTERNAL_ASSERTS
    `include "internal_helper_decls.vh"
`endif

    gold_top i_gold (
        .Clk(Clk),
        .Addr(Addr),
        .WrEna(WrEna),
        .WrData(WrData),
        .RdData(gold_RdData)
`ifdef INTERNAL_ASSERTS
        `include "internal_helper_ports_a.vh"
`endif
    );

    gate_top i_gate (
        .Clk(Clk),
        .Addr(Addr),
        .WrEna(WrEna),
        .WrData(WrData),
        .RdData(gate_RdData)
`ifdef INTERNAL_ASSERTS
        `include "internal_helper_ports_b.vh"
`endif
    );

    always @(posedge Clk) begin
        assert(gold_RdData == gate_RdData);
`ifdef INTERNAL_ASSERTS
        `include "internal_helper_asserts.vh"
`endif
    end
endmodule
