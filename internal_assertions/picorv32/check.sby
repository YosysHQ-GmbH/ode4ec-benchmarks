[tasks]
task_bmc
task_prove

[options]
task_bmc: mode bmc
task_bmc: depth 70
task_bmc: timeout 1800
task_prove: mode prove
task_prove: timeout 1800

[engines]
task_bmc: smtbmc bitwuzla
task_prove: abc pdr

[cancelledby]
task_bmc: task_prove

[script]
# Gold
read_rtlil gold_out.il

# Gate
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil gate_out.il

# Miter
miter -equiv -flatten -make_assert gold_top gate_top equiv_miter
hierarchy -top equiv_miter
flatten
opt

fminit -seq in_resetn 0,0,1
fminit -set in_clk 0

setundef -undriven -init -zero

[files]
../sky130
gold_out.il
gate_out.il
