[tasks]
task_btor
task_abc
task_aiger
task_bitwuzla

[options]
task_btor: mode bmc
task_btor: depth 70
task_btor: timeout 1800

task_abc: mode prove
task_abc: timeout 1800
task_aiger: mode prove
task_aiger: timeout 1800

task_bitwuzla: mode bmc
task_bitwuzla: depth 70
task_bitwuzla: timeout 1800

[engines]
task_btor: btor btormc
task_bitwuzla: smtbmc bitwuzla

task_abc: abc pdr
task_aiger: aiger suprove

[script]
# Gold
read_rtlil gold_out.il

select -module gold_top
fminit -set cpuregs[1] 0
fminit -set cpuregs[2] 0
fminit -set cpuregs[3] 0
fminit -set cpuregs[4] 0
