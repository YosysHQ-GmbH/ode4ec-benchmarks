fminit -set cpuregs[30] 0
fminit -set cpuregs[31] 0
select -clear

# Gate
read_liberty -ignore_miss_func sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil gate_out.il

select -module gate_top
fminit -set cpuregs[1][0] 0
