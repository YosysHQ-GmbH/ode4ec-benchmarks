module miter (
    input Clk,
    input Rst,
    input [@WIDTH@*@GRANT@-1:0] Weights,
    input In_Valid,
    input [@GRANT@-1:0] In_Req
);

    wire gold_Out_Valid, gate_Out_Valid;
    wire [@GRANT@-1:0] gold_Out_Grant, gate_Out_Grant;

`ifdef INTERNAL_ASSERTS
    `include "internal_helper_decls.vh"
`endif

    gold_top i_gold (
        .Clk(Clk),
        .Rst(Rst),
        .Weights(Weights),
        .In_Valid(In_Valid),
        .In_Req(In_Req),
        .Out_Valid(gold_Out_Valid),
        .Out_Grant(gold_Out_Grant)
`ifdef INTERNAL_ASSERTS
        `include "internal_helper_ports_a.vh"
`endif
    );

    gate_top i_gate (
        .Clk(Clk),
        .Rst(Rst),
        .Weights(Weights),
        .In_Valid(In_Valid),
        .In_Req(In_Req),
        .Out_Valid(gate_Out_Valid),
        .Out_Grant(gate_Out_Grant)
`ifdef INTERNAL_ASSERTS
        `include "internal_helper_ports_b.vh"
`endif
    );

    always @(posedge Clk) begin
        assert(gold_Out_Valid == gate_Out_Valid);
        assert(gold_Out_Grant == gate_Out_Grant);
`ifdef INTERNAL_ASSERTS
        `include "internal_helper_asserts.vh"
`endif
    end
endmodule
