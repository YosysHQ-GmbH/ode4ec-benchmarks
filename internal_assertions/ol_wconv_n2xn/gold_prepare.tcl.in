yosys -import

set design           $::env(TOP_MODULE)
set lib_file         $::env(TIMING_LIB)
set flist_vcs        $::env(FLIST)

# read design
plugin -i ghdl
ghdl --std=08 -frelaxed -gInWidth_g=@IN@ -gOutWidth_g=@OUT@ ../src/olo_base_pkg_array.vhd ../src/olo_base_pkg_attribute.vhd ../src/olo_base_pkg_math.vhd ../src/olo_base_pkg_logic.vhd ../src/olo_base_pkg_string.vhd ../src/olo_base_cc_reset.vhd ../src/olo_base_cc_bits.vhd ../src/olo_base_ram_sdp.vhd ../src/olo_base_wconv_n2xn.vhd -e olo_base_wconv_n2xn

hierarchy -check -top olo_base_wconv_n2xn
memory_map -formal
flatten
opt_clean -purge
chformal -assert -remove
yosys rename olo_base_wconv_n2xn gold_top
flatten
write_rtlil @GOLD@
